local function removeOld(obj)
	local i = table.find(oldList, obj)
	if i then table.remove(oldList, i) end
	oldSet[obj] = nil
	if oldBoxes[obj] then oldBoxes[obj]:Destroy(); oldBoxes[obj] = nil end
end
local function clearOld()
	for _, b in pairs(oldBoxes) do b:Destroy() end
	oldList, oldSet, oldBoxes = {}, {}, {}
	refreshInfo()
end
local function addOld(obj, noBox)
	if obj == newObj then toast("Itu objek baru, pilih yang lain", C.BAD); return end
	if oldSet[obj] then return end
	oldSet[obj] = true
	table.insert(oldList, obj)
	oldBoxes[obj] = (not noBox) and makeBox(obj, C.GOLD) or nil
	refreshInfo()
end
local function setNew(obj)
	if newBox then newBox:Destroy(); newBox = nil end
	if oldSet[obj] then removeOld(obj) end
	newObj = obj
	newBox = makeBox(obj, C.OK)
	refreshInfo()
	toast("Objek baru: " .. obj.Name, C.OK)
end
local function rebuildBoxes()
	if newBox then newBox:Destroy(); newBox = nil end
	for _, b in pairs(oldBoxes) do b:Destroy() end
	oldBoxes = {}
	if newObj and newObj.Parent then newBox = makeBox(newObj, C.OK) end
	for _, o in ipairs(oldList) do oldBoxes[o] = makeBox(o, C.GOLD) end
end

