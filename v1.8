-- ================= HELPER UI =================
local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) return mk("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, col, th, tr)
	return mk("UIStroke", {Color=col, Thickness=th or 1, Transparency=tr or 0, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, o)
end
local function grad(o, c0, c1, rot)
	return mk("UIGradient", {Color=ColorSequence.new(c0, c1), Rotation=rot or 0}, o)
end
local function tw(o, props, t, style)
	TS:Create(o, TweenInfo.new(t or .18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

