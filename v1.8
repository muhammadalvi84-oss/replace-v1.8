-- ===== PILIH SEKALIGUS: cari semua objek bernama sama =====
local function sizeSig(o)
	local v = getSize(o)
	local t = {v.X, v.Y, v.Z}
	table.sort(t)
	return t
end
local function sameSize(a, b)
	for i = 1, 3 do
		if math.abs(a[i] - b[i]) > math.max(.05, b[i] * .05) then return false end
	end
	return true
end
local function inCharacter(o)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character and o:IsDescendantOf(pl.Character) then return true end
	end
	return false
end
local function addSimilar(ref)
	local root = (scopeMode == 2 and ref.Parent) or workspace
	local generic = (ref.Name == ref.ClassName) or ref.Name == "Part" or ref.Name == "Model"
	local needSize = (critMode == 2) or generic
	local refSig = needSize and sizeSig(ref) or nil
	local found, matched = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		if d ~= newObj and d.Name == ref.Name and d.ClassName == ref.ClassName
			and (d:IsA("Model") or d:IsA("BasePart")) and not (newObj and d:IsDescendantOf(newObj)) then
			local nested, a = false, d.Parent
			while a and a ~= root do
				if matched[a] then nested = true; break end
				a = a.Parent
			end
			if not nested and not inCharacter(d) and (not needSize or sameSize(sizeSig(d), refSig)) then
				matched[d] = true
				table.insert(found, d)
			end
		end
	end
	if #found > 500 then
		toast("Terlalu banyak (" .. #found .. "). Ganti LINGKUP/KRITERIA di tab OPSI", C.BAD)
		return
	end
	local noBox = #found > 60
	oldSource = (#oldList == 0) and ("⚡ " .. ref.Name) or "⚡ campuran"
	local added = 0
	for _, d in ipairs(found) do
		if not oldSet[d] then addOld(d, noBox); added = added + 1 end
	end
	local msg = "⚡ " .. added .. " objek '" .. ref.Name .. "' ditambahkan"
	if generic then msg = msg .. " (cocok ukuran)" end
	if noBox then msg = msg .. " • outline off" end
	toast(msg, added > 0 and C.OK or C.WARN)
end

-- ===== SALIN FOLDER (map asli tetap aman) =====
local function copyContainer(src)
	local cp = src:Clone()
	cp.Name = src.Name .. "_COPY"
	if copyShift ~= 1 then
		local v = (copyShift == 2) and Vector3.new(400, 0, 0) or Vector3.new(0, 0, 400)
		for _, ch in ipairs(cp:GetChildren()) do
			if ch:IsA("Model") or ch:IsA("BasePart") then shiftBy(ch, v) end
		end
	end
	cp.Parent = src.Parent
	return cp
end

-- ===== CARI NAMA & KOTAK =====
local function unitOf(part)
	if tapMode == 1 and part.Parent and part.Parent ~= workspace and part.Parent:IsA("Model") then
		return part.Parent
	end
	return part
end

local function commitFound(found, label)
	-- buang objek yang berada di dalam objek lain yang juga terpilih (hindari ganda)
	local set = {}
	for _, d in ipairs(found) do set[d] = true end
	local clean = {}
	for _, d in ipairs(found) do
		local nested, a = false, d.Parent
		while a and a ~= workspace do
			if set[a] then nested = true; break end
			a = a.Parent
		end
		if not nested then table.insert(clean, d) end
	end
	found = clean
	if #found == 0 then toast("Tidak ada yang cocok", C.WARN); fabNote("Tidak ada yang cocok"); return end
	if #found > 500 then
		toast("Terlalu banyak (" .. #found .. "). Persempit filter/area", C.BAD)
		fabNote("Terlalu banyak (" .. #found .. ")")
		return
	end
	local noBox = #found > 60
	oldSource = (#oldList == 0) and label or "campuran"
	local added = 0
	for _, d in ipairs(found) do
		if not oldSet[d] then addOld(d, noBox); added = added + 1 end
	end
	toast(label .. " • " .. added .. " objek ditambahkan" .. (noBox and " • outline off" or ""), added > 0 and C.OK or C.WARN)
	fabNote(label .. " +" .. added .. " • total " .. #oldList, 4)
end

local function searchByName()
	local q = string.lower(filterBox.Text or "")
	if q == "" then toast("Ketik nama dulu di kolom filter", C.BAD); return end
	local found = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if (d:IsA("Model") or d:IsA("BasePart")) and not d:IsA("Terrain")
			and string.find(string.lower(d.Name), q, 1, true)
			and d ~= newObj and not (newObj and d:IsDescendantOf(newObj)) and not inCharacter(d) then
			table.insert(found, d)
		end
	end
	commitFound(found, "🔎 " .. filterBox.Text)
end

local function boxSelect(p1, p2)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local x0, x1 = math.min(p1.X, p2.X), math.max(p1.X, p2.X)
	local y0, y1 = math.min(p1.Y, p2.Y), math.max(p1.Y, p2.Y)
	local q = string.lower(filterBox.Text or "")
	local seen, found = {}, {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain") then
			local v, on = cam:WorldToViewportPoint(d.Position)
			if on and v.X >= x0 and v.X <= x1 and v.Y >= y0 and v.Y <= y1 then
				local u = unitOf(d)
				if not seen[u] then
					seen[u] = true
					local sz = getSize(u)
					if u ~= newObj and not (newObj and u:IsDescendantOf(newObj)) and not inCharacter(u)
						and math.max(sz.X, sz.Y, sz.Z) <= 400
						and (q == "" or string.find(string.lower(u.Name), q, 1, true)) then
						table.insert(found, u)
					end
				end
			end
		end
	end
	commitFound(found, "▭ kotak")
end

local function boxTap()
	local pos = UIS:GetMouseLocation()
	if not boxFirst then
		boxFirst = pos
		selDot.Position = UDim2.fromOffset(pos.X, pos.Y); selDot.Visible = true
		fabNote("▭ Sudut 1 ✔  tap sudut seberangnya", 5)
	else
		local p1 = boxFirst
		boxFirst = nil
		selDot.Visible = false
		selRect.Position = UDim2.fromOffset(math.min(p1.X, pos.X), math.min(p1.Y, pos.Y))
		selRect.Size = UDim2.fromOffset(math.abs(p1.X - pos.X), math.abs(p1.Y - pos.Y))
		selRect.Visible = true
		boxSelect(p1, pos)
		task.delay(.8, function() selRect.Visible = false end)
	end
end

local function overUI()
	if Fab.Visible then
		local fp, fa, fs = UIS:GetMouseLocation(), Fab.AbsolutePosition, Fab.AbsoluteSize
		if fp.X >= fa.X and fp.X <= fa.X + fs.X and fp.Y >= fa.Y and fp.Y <= fa.Y + fs.Y then return true end
	end
	if not Main.Visible then return false end
	local p = UIS:GetMouseLocation()
	local a, s = Main.AbsolutePosition, Main.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

