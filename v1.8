-- ================= REPLACE / UNDO =================
local function doReplace(keep)
	if busy then return end
	if not newObj or not newObj.Parent then toast("Pilih objek baru dulu!", C.BAD); return end
	local list = {}
	for _, o in ipairs(oldList) do
		if o.Parent and o ~= newObj then table.insert(list, o) end
	end
	if #list == 0 then toast("Pilih objek lama dulu!", C.BAD); return end
	busy = true; setPick(nil)
	toast("Memproses " .. #list .. " objek...", C.WARN)
	task.spawn(function()
		local ok, fail, rec = 0, 0, {}
		local firstErr
		for i, old in ipairs(list) do
			local c
			local success, err = pcall(function()
				local parent = old.Parent
				local fo = getFrame(old)
				if not fo then error("objek lama tidak punya part") end
				c = newObj:Clone()
				c.Parent = parent
				local fn = getFrame(c)
				if not fn then error("objek baru tidak punya part") end
				if scaleMode == 1 and fn.size.X > .001 then
					scaleUniform(c, fo.size.X / fn.size.X)
					fn = getFrame(c)
				end
				if rotMode == 1 then
					local target = fo.rot * CFrame.Angles(0, 0, math.rad(90 * yawStep))
					rotateAbout(c, fn.center, target * fn.rot:Inverse())
					fn = getFrame(c)
				end
				shiftBy(c, fo.center - fn.center)
				if keep then
					table.insert(rec, {old = old, parent = parent, new = c})
					old.Parent = nil
				else
					old:Destroy()
				end
			end)
			if success then ok = ok + 1 else fail = fail + 1; firstErr = firstErr or tostring(err); warn("[King Alvi] gagal:", err); if c then c:Destroy() end end
			if i % 10 == 0 then RunService.Heartbeat:Wait() end
		end
		if keep and #rec > 0 then
			table.insert(undoStack, rec)
			if #undoStack > 5 then table.remove(undoStack, 1) end
		end
		clearOld()
		busy = false
		if fail == 0 then toast("Berhasil mengganti " .. ok .. " obstacle!", C.OK)
		else toast(ok .. " berhasil, " .. fail .. " gagal: " .. string.sub(firstErr or "?", 1, 70), C.WARN) end
	end)
end

local function doUndo()
	local rec = table.remove(undoStack)
	if not rec then toast("Tidak ada yang bisa di-undo", C.WARN); return end
	local n = 0
	for _, r in ipairs(rec) do
		pcall(function()
			if r.new and r.new.Parent then r.new:Destroy() end
			r.old.Parent = r.parent
			n = n + 1
		end)
	end
	toast("Undo: " .. n .. " objek dikembalikan", C.OK)
end

