local function listModelFiles(folder)
	local candidates = (folder ~= "") and {folder} or {"", "."}
	local lastErr = "listfiles tidak tersedia"
	for _, arg in ipairs(candidates) do
		local ok, files = pcall(listfiles, arg)
		if ok and type(files) == "table" then
			local out = {}
			for _, f in ipairs(files) do
				local low = string.lower(f)
				if low:match("%.rbxmx?$") or low:match("%.rbxlx?$") then table.insert(out, f) end
			end
			table.sort(out)
			return out
		end
		lastErr = tostring(files)
	end
	return nil, lastErr
end

-- kunci semua part (Anchored) + hentikan gerak; return jumlah yang berhasil & total
local function anchorAll(root)
	local total, okc = 0, 0
	for i, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			total = total + 1
			pcall(function()
				d.Anchored = true
				d.AssemblyLinearVelocity = Vector3.zero
				d.AssemblyAngularVelocity = Vector3.zero
			end)
			if d.Anchored then okc = okc + 1 end
		end
		if i % 1500 == 0 then RunService.Heartbeat:Wait() end
	end
	return okc, total
end

local function loadModelFile(path)
	local gca = getcustomasset or getsynasset
	if not gca then return nil, "executor tidak punya getcustomasset" end
	local ext = string.lower(path):match("%.(%w+)$") or ""
	local isPlace = (ext == "rbxl" or ext == "rbxlx")
	local tmp
	local loadPath = path
	if isPlace then
		-- file place: disalin sementara dengan ekstensi model supaya bisa dimuat
		local okR, data = pcall(readfile, path)
		if not okR or type(data) ~= "string" then return nil, "gagal membaca file place" end
		tmp = "KA_tmp_" .. tostring(os.time()) .. ((ext == "rbxl") and ".rbxm" or ".rbxmx")
		local okW = pcall(writefile, tmp, data)
		if not okW then return nil, "executor tidak bisa menulis file sementara" end
		loadPath = tmp
	end
	local roots, err
	local okA, asset = pcall(gca, loadPath)
	if okA and asset then
		local ok1, r1 = pcall(function() return game:GetObjects(asset) end)
		if ok1 and type(r1) == "table" and #r1 > 0 then
			roots = r1
		else
			local ok2, r2 = pcall(function() return game:GetService("InsertService"):LoadLocalAsset(asset) end)
			if ok2 and r2 then roots = {r2} else err = "file tidak bisa dimuat (format/executor)" end
		end
	else
		err = "gagal membaca file"
	end
	if tmp then pcall(delfile, tmp) end
	if not roots then return nil, err end
	return roots, nil, isPlace
end

local importing = false
local function importFile(path)
	if importing then return end
	importing = true
	task.spawn(function()
		toast("Memuat file...", C.WARN)
		local roots, err, isPlace = loadModelFile(path)
		if not roots then
			toast("Gagal: " .. tostring(err), C.BAD); importing = false; return
		end
		local name = path:match("([^/\\]+)%.[^.]+$") or "file"
		local folder = Instance.new("Folder")
		folder.Name = "KA_" .. name
		local units = {}
		local function take(i)
			if (i:IsA("Model") or i:IsA("BasePart") or i:IsA("Folder")) and i.ClassName ~= "Terrain" then
				i.Parent = folder; table.insert(units, i)
			end
		end
		for _, r in ipairs(roots) do
			if isPlace then
				if r.ClassName == "Workspace" then
					for _, ch in ipairs(r:GetChildren()) do take(ch) end
				end
			elseif r:IsA("Model") or r:IsA("BasePart") or r:IsA("Folder") then
				take(r)
			else
				for _, ch in ipairs(r:GetChildren()) do take(ch) end
			end
		end
		if isPlace and #units == 0 then
			for _, r in ipairs(roots) do
				if r:IsA("Model") or r:IsA("BasePart") or r:IsA("Folder") then take(r)
				else for _, ch in ipairs(r:GetChildren()) do take(ch) end end
			end
		end
		if #units == 0 then
			folder:Destroy(); toast("File kosong / tidak ada objek bangunan", C.WARN); importing = false; return
		end
		local removed = 0
		if scriptMode == 2 then
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("LuaSourceContainer") then d:Destroy(); removed = removed + 1 end
			end
		end
		local okN, totN = 0, 0
		if anchorMode == 1 then okN, totN = anchorAll(folder) end
		if posMode == 2 then
			local cam = workspace.CurrentCamera
			local INF = math.huge
			local mn, mx, any = Vector3.new(INF,INF,INF), Vector3.new(-INF,-INF,-INF), false
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("BasePart") then
					any = true
					local pp = d.Position
					mn = Vector3.new(math.min(mn.X,pp.X), math.min(mn.Y,pp.Y), math.min(mn.Z,pp.Z))
					mx = Vector3.new(math.max(mx.X,pp.X), math.max(mx.Y,pp.Y), math.max(mx.Z,pp.Z))
				end
			end
			if any and cam then
				local v = (cam.CFrame.Position + cam.CFrame.LookVector * 40) - (mn + mx) * .5
				local function shiftTree(inst)
					if inst:IsA("Model") or inst:IsA("BasePart") then shiftBy(inst, v)
					elseif inst:IsA("Folder") then
						for _, c in ipairs(inst:GetChildren()) do shiftTree(c) end
					end
				end
				for _, u in ipairs(units) do shiftTree(u) end
			end
		end
		folder.Parent = workspace
		if anchorMode == 1 then
			-- kunci ulang setelah masuk Workspace, lalu pantau 5 detik (part baru / anchor yang dilepas)
			okN, totN = anchorAll(folder)
			local watch
			watch = folder.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") then pcall(function() d.Anchored = true end) end
			end)
			task.delay(5, function() if watch then watch:Disconnect() end end)
		end
		if asNewMode == 1 and #units == 1 and (units[1]:IsA("Model") or units[1]:IsA("BasePart")) then
			setNew(units[1])
		end
		local msg = "✅ " .. #units .. " objek dimuat → " .. folder.Name
		if removed > 0 then msg = msg .. " • " .. removed .. " script dibuang" end
		if anchorMode == 1 then msg = msg .. " • anchor " .. okN .. "/" .. totN .. " part" end
		toast(msg, C.OK)
		importing = false
	end)
end

local function refreshFiles()
	for _, ch in ipairs(listFrame:GetChildren()) do
		if ch:IsA("Frame") then ch:Destroy() end
	end
	local files, err = listModelFiles(folderBox.Text or "")
	if not files then fileNote.Text = "Executor-mu tidak bisa membaca folder: " .. tostring(err); return end
	if #files == 0 then fileNote.Text = "Tidak ada file .rbxm/.rbxmx/.rbxl/.rbxlx di folder ini."; return end
	fileNote.Text = #files .. " file ditemukan"
	for i, path in ipairs(files) do
		local row = mk("Frame", {LayoutOrder=i, Size=UDim2.new(1,0,0,34), BackgroundColor3=C.CARD, BorderSizePixel=0}, listFrame)
		corner(row, 8); stroke(row, C.LINE, 1)
		mk("TextLabel", {Size=UDim2.new(1,-84,1,0), Position=UDim2.new(0,10,0,0), BackgroundTransparency=1,
			Text=path:match("[^/\\]+$") or path, TextColor3=C.TEXT, TextSize=11, Font=Enum.Font.GothamMedium,
			TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd}, row)
		local b = button(row, "MUAT", C.PURPLE, C.TEXT, UDim2.new(0,64,0,24), UDim2.new(1,-70,.5,-12))
		b.MouseButton1Click:Connect(function() importFile(path) end)
	end
end
